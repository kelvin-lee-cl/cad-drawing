rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /cad/project {
      allow read, write: if request.auth != null;
    }

    match /cad/lock {
      allow read, write: if request.auth != null;
    }

    match /cad/project/saveLogs/{logId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
